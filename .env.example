# =============================================================================
# Copy to .env.local for local development. On your host, set the same names in
# the project's environment settings.
#
# IMPORTANT: every NEXT_PUBLIC_* value is read at BUILD time and becomes visible in the
# browser. Changing one needs a rebuild/redeploy. Never put a secret in a NEXT_PUBLIC_ variable.
# This app needs NO server-side secrets: it never uses the Supabase service-role key.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
# Supabase dashboard -> Project Settings -> API Keys. Use the PUBLISHABLE (anon) key only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- Product identity (optional, rebuild after changing) ----------------------
NEXT_PUBLIC_APP_NAME=Persist
NEXT_PUBLIC_APP_TAGLINE=Show up. Leave proof.

# --- Deployment details (optional, rebuild after changing) --------------------
# Public URL of the deployed app, no trailing slash. Example: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=
# Where users can reach you. Shown on the Support page and in the policies.
# Leave blank until you have a real address; the pages say contact details are unavailable.
# Example: support@yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional legal details. Shown on the policy pages only if you fill them in; nothing is invented.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# --- Sign-in (optional) -------------------------------------------------------
# Set to "true" only after enabling the Google provider in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# --- Ads (OFF by default) -----------------------------------------------------
# Ads stay hidden unless ADS_ENABLED is exactly "true" AND the IDs below are valid.
# Do not enable until your AdSense site is approved and crawler access is set up (see README).
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_PROVIDER=adsense
# Your AdSense publisher ID, in the form ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
# Your ad unit's slot ID (digits only)
NEXT_PUBLIC_ADSENSE_SLOT=
